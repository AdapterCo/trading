# Copy to .env and fill in. Never commit .env (instrucao.md #92).
# TRADING_MODE must never default to live (instrucao.md #5, #94).
TRADING_MODE=paper
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/adaptertrading

SYMBOL=BTCUSDT
BASE_ASSET=BTC
QUOTE_ASSET=USDT

BASE_INTERVAL=1m
ENTRY_INTERVAL=5m
TREND_INTERVAL=15m
MACRO_INTERVAL=1h

ADX_MIN=20
RSI_ENTRY_MIN=45
RSI_ENTRY_MAX=65
PULLBACK_MAX_DISTANCE=0.003
MIN_VOLUME_RATIO=1.0
MIN_TAKER_BUY_RATIO=0.50
MAX_SPREAD=0.001

RISK_PER_TRADE=0.01
MAX_CAPITAL_ALLOCATION=0.95
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
MAX_CONSECUTIVE_LOSSES=3

STOP_ATR_MULTIPLIER=1.5
MAX_STOP_PERCENT=0.02

TAKE_PROFIT_R=2.0
BREAK_EVEN_TRIGGER_R=1.0
TRAILING_START_R=1.5
TRAILING_ATR_MULTIPLIER=1.0

COOLDOWN_CANDLES=2
MAX_OPEN_POSITIONS=1

MAX_ORDERS_PER_HOUR=6
MAX_ENTRIES_PER_DAY=10

STALE_MARKET_DATA_TIMEOUT_SECONDS=90

# Binance API key must have SPOT trading enabled and WITHDRAWAL disabled (instrucao.md #91).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bearer token required by critical control endpoints (start/pause/resume/emergency_exit).
CONTROL_API_TOKEN=
